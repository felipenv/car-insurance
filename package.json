{
  "name": "car-insurance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Car-insurance premium estimator monorepo (PDLC factory demo).",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && node scripts/check-core-boundary.mjs",
    "lint:boundary": "node scripts/check-core-boundary.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4"
  }
}
