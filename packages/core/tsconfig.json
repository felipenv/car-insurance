{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Framework-agnostic CORE library. Extends the shared base and emits
  // declarations + JS into ./dist so WEB can consume it via a project
  // reference (see ../web/tsconfig.json).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  // Test files and test-only fixtures are excluded from the emitted library:
  // they exercise the engine via Vitest (which transpiles them itself) but must
  // not ship in ./dist.
  "exclude": ["src/**/*.test.ts", "src/**/__fixtures__/**"]
}
